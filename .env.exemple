# Copier en .env et compléter. Ne committez JAMAIS votre .env perso !

# Imposés par l'image officielle PostgreSQL
POSTGRES_USER=hbntory
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hbntory
DATABASE_URL=postgresql+psycopg://hbntory:changeme@db:5432/hbntory

# Clé de signature de cookie personnelle, à changer aussi !
SECRET_KEY=dev-secret-a-changer

# Depuis un CONTENEUR : nom du service + port interne
PRODUCT_API_URL=http://external-products-api:5000
PRODUCT_API_PREFIX=/api/v1
# Depuis TA MACHINE (curl, navigateur) : http://localhost:5001

MCP_SERVER_URL=http://mcp-server:8001/mcp

# Anthropic, Gemini, GPT, Ollama (locale), renseigner la bonne API...
ANTHROPIC_API_KEY=
