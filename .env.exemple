# Copier en .env et compléter. Ne committez JAMAIS votre .env perso !

# Imposés par l'image officielle PostgreSQL
POSTGRES_USER=hbntory
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hbntory
DATABASE_URL=postgresql+psycopg://hbntory:changeme@db:5432/hbntory

# Clé de signature de cookie personnelle, à changer aussi via python3 -c "import secrets; print(secrets.token_hex(24))"
SECRET_KEY=dev-secret-a-changer

# Depuis un CONTENEUR : nom du service + port interne
PRODUCT_API_URL=http://external-products-api:5000
PRODUCT_API_PREFIX=/api/v1
# Depuis TA MACHINE (curl, navigateur) : http://localhost:5001

MCP_SERVER_URL=http://mcp-server:8001/mcp

# Anthropic, Gemini, GPT, Ollama (locale), renseigner la bonne API...
ANTHROPIC_API_KEY=

# --- Rôle PostgreSQL en lecture seule, utilisé par le serveur MCP ---
# Il ne peut lire que branches et stock. Aucun accès à users.
MCP_DB_USER=mcp_reader

# Generer et remplacer avec python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MCP_DB_PASSWORD=readonly-changeme

# Remplacer readonly-changeme avec le mot de passe généré au dessus
MCP_DATABASE_URL=postgresql+psycopg://mcp_reader:readonly-changeme@db:5432/hbntory

# Comptes créés par le seed
ADMIN_PASSWORD=ChangeMe123!
SEED_USER_PASSWORD=Test123!

# API produits externe (nom de service Docker -> port interne)
PRODUCTS_API_URL=http://external-products-api:5000
